{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/compose.py": {
      "maxDuration": 30,
      "includeFiles": "api/_shared.py"
    },
    "api/letter.py": {
      "maxDuration": 15,
      "includeFiles": "api/_shared.py"
    }
  },
  "rewrites": [
    { "source": "/:id([a-z0-9][a-z0-9-]{1,18}[a-z0-9])", "destination": "/read.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
