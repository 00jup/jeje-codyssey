# Google AI Studio(https://aistudio.google.com/apikey)에서 발급한 키를 입력하세요.
# 실제 .env는 커밋하지 않습니다.
GEMINI_API_KEY=your_gemini_api_key_here

# 필요할 때만 모델을 변경하세요.
GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# 로고 생성 수: 2 또는 3. 최종 원칙의 세 스타일을 모두 보려면 3을 사용합니다.
# Gemini 이미지 모델은 유료 프로젝트가 필요하며 이미지마다 비용이 발생합니다.
BRAND_LOGO_COUNT=3
