# Codyssey AI 게이트웨이(https://copa.codyssey.kr)의 Anthropic 프로토콜 virtual key.
# 실제 값이 담긴 .env 는 절대 커밋하지 않는다. 배포 환경에는 Vercel 대시보드의
# Settings > Environment Variables 로 넣는다.
ANTHROPIC_API_KEY=sk-cody-live-xxxxxxxxxxxxxxxxxxxxxxxx

# Upstash Redis(REST) — 편지를 짧은 링크로 저장하는 곳.
# https://console.upstash.com 에서 무료 Redis 데이터베이스를 만들고
# REST API 섹션의 URL/TOKEN을 그대로 넣는다.
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
